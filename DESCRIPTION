Package: CampoPixel
Type: Package
Title: Processamento e Análise de Imagens RGB para Agricultura
Version: 0.1.0
Date: 2025-08-20
Authors@R: c(
    person(given = "Wilhan Valasco", family = "dos Santos", role = c("aut", "cre"),
           email = "wilhanvalasco@hotmail.com"),
    person(given = "Walter Baida", family = "Garcia Coutinho", role = "aut",
