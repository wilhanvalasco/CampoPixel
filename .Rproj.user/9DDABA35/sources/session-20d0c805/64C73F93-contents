Title: Processamento de Imagens RGB para Agricultura de Digital
Version: 0.1.0
Authors@R: c(
    person(
      "Wilhan", "Valasco",
      email = "wilhanvalasco@hotmail.com",
      role = c("aut", "cre")
    )
